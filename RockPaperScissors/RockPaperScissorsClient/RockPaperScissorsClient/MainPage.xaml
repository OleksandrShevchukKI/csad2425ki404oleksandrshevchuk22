<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RockPaperScissorsClient"
             x:Class="RockPaperScissorsClient.MainPage">

    <ContentPage.BindingContext>
        <local:MainPageViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackLayout Grid.Column="0" VerticalOptions="Start" Margin="10"
                     HorizontalOptions="Center">
            <Label Text="Select Play Mode" FontSize="Medium"/>
            <Picker ItemsSource="{Binding PlayModes}"
                    SelectedItem="{Binding PlayMode}">
            </Picker>
        </StackLayout>

        <StackLayout Grid.Column="1" Padding="20" HorizontalOptions="StartAndExpand" VerticalOptions="Start">
            <Picker Title="First Player Choice"
                ItemsSource="{Binding Choices}"
                SelectedItem="{Binding FirstPlayerChoice}"
                WidthRequest="300" 
                HorizontalOptions="Center"
                Margin="0,10"/>

            <Picker Title="Second Player Choice"
                ItemsSource="{Binding Choices}"
                SelectedItem="{Binding SecondPlayerChoice}"
                WidthRequest="300" 
                HorizontalOptions="Center"
                Margin="0,10"/>

            <Button Text="Play" Command="{Binding PlayCommand}"
                WidthRequest="300"
                HorizontalOptions="Center"
                Margin="0,10"/>

            <Label Text="Result:" FontSize="18" HorizontalOptions="Center"
                    Margin="10"/>
            <Label Text="{Binding Result}" FontSize="18" HorizontalOptions="Center"
                    Margin="10"/>
        </StackLayout>

        <StackLayout Grid.Column="2" Padding="20" HorizontalOptions="StartAndExpand" VerticalOptions="Start">
            <Button Text="New Game" Command="{Binding NewGameCommand}"
                  WidthRequest="250"
                  HorizontalOptions="Center"
                  Margin="10"/>
            <Button Text="Save Game" Command="{Binding SaveGameCommand}"
                  WidthRequest="250"
                  HorizontalOptions="Center"
                  Margin="10"/>
            <Button Text="Load Game" Command="{Binding LoadGameCommand}"
                  WidthRequest="250"
                  HorizontalOptions="Center"
                  Margin="10"/>
        </StackLayout>
    </Grid>

</ContentPage>
