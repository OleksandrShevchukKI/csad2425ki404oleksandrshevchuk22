<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RockPaperScissorsClient.MainPage">

    <Grid Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackLayout Grid.Column="0" VerticalOptions="Start" Margin="10"
                     HorizontalOptions="Center">
            <Label Text="Select Play Mode" FontSize="Medium"/>
            <Picker x:Name="PlayModePicker">
                <Picker.Items>
                    <x:String>ManVsAI</x:String>
                    <x:String>ManVsMan</x:String>
                    <x:String>AIvsAIRandom</x:String>
                    <x:String>AIvsAIWinStrategy</x:String>
                </Picker.Items>
            </Picker>
        </StackLayout>

        <StackLayout Grid.Column="1" Padding="20" HorizontalOptions="StartAndExpand" VerticalOptions="Start">
            <Picker x:Name="UserChoicePicker" 
                Title="Select Your Move"
                WidthRequest="300" 
                HorizontalOptions="Center"
                Margin="0,10"/>

            <Button Text="Play" Clicked="PlayButton_Click"
                WidthRequest="300"
                HorizontalOptions="Center"
                Margin="0,10"/>

            <Label x:Name="ResultLabel" FontSize="18" HorizontalOptions="Center"
                    Margin="10"/>
        </StackLayout>

        <StackLayout Grid.Column="2" Padding="20" HorizontalOptions="StartAndExpand" VerticalOptions="Start">
            <Button Text="New Game" Clicked="NewGameButton_Click"
                  WidthRequest="250"
                  HorizontalOptions="Center"
                  Margin="10"/>
            <Button Text="Save" Clicked="SaveButton_Click"
                  WidthRequest="250"
                  HorizontalOptions="Center"
                  Margin="10"/>
            <Button Text="Load" Clicked="LoadButton_Click"
                  WidthRequest="250"
                  HorizontalOptions="Center"
                  Margin="10"/>
        </StackLayout>
    </Grid>

</ContentPage>
